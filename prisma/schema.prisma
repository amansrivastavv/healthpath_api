generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  LAB_OWNER
  LAB_STAFF
  TECHNICIAN
  PATIENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

model User {
  id              String      @id @default(uuid())
  fullName        String      @map("full_name")
  email           String      @unique
  password        String

  phoneNumber     String?     @unique @map("phone_number")
  countryCode     String?     @map("country_code")

  profileImage    String?     @map("profile_image")

  role            UserRole    @default(PATIENT)
  status          UserStatus  @default(PENDING_VERIFICATION)

  emailVerified             Boolean     @default(false) @map("email_verified")
  phoneVerified             Boolean     @default(false) @map("phone_verified")

  passwordResetToken       String?     @map("password_reset_token")
  passwordResetExpires     DateTime?   @map("password_reset_expires")

  lastLoginAt     DateTime?   @map("last_login_at")

  // Relations
  providers       Provider[]

  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@index([email])
  @@index([phoneNumber])
  @@index([role])
  @@index([status])
  @@index([passwordResetToken])

  @@map("users")
}

// ─── Provider ───────────────────────────────────────────────

enum ProviderType {
  LAB
  CLINIC
  BOTH
}

model Provider {
  id                      String        @id @default(uuid())
  name                    String
  slug                    String        @unique
  type                    ProviderType

  description             String?       @db.Text

  email                   String?
  phone                   String?

  // Address
  address                 String?
  city                    String?
  state                   String?
  country                 String?       @default("India")
  pincode                 String?

  // Geolocation
  latitude                Float?
  longitude               Float?

  // Ratings & metrics
  rating                  Float?        @default(0)
  totalRatings            Int           @default(0) @map("total_ratings")

  // Operating details
  openingHours            Json?         @map("opening_hours")
  homeCollectionAvailable Boolean       @default(false) @map("home_collection_available")

  // Images
  profileImage            String?       @map("profile_image")
  coverImage              String?       @map("cover_image")

  // Status flags
  isVerified              Boolean       @default(false) @map("is_verified")
  isActive                Boolean       @default(true) @map("is_active")
  isFeatured              Boolean       @default(false) @map("is_featured")

  // Ownership (future: link to User who manages this provider)
  ownerId                 String?       @map("owner_id")
  owner                   User?         @relation(fields: [ownerId], references: [id])

  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")

  @@index([type])
  @@index([city])
  @@index([state])
  @@index([pincode])
  @@index([isVerified])
  @@index([isActive])
  @@index([isFeatured])
  @@index([rating])
  @@index([ownerId])
  @@index([latitude, longitude])

  @@map("providers")
}