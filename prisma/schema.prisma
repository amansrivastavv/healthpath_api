generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "mysql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  LAB_OWNER
  LAB_STAFF
  TECHNICIAN
  DOCTOR
  PATIENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

model User {
  id              String      @id @default(uuid())
  fullName        String      @map("full_name")
  email           String      @unique
  password        String?
  authProvider    AuthProvider @default(LOCAL) @map("auth_provider")
  googleId        String?     @unique @map("google_id")

  phoneNumber     String?     @unique @map("phone_number")
  countryCode     String?     @map("country_code")

  profileImage    String?     @map("profile_image")

  role            UserRole    @default(PATIENT)
  status          UserStatus  @default(PENDING_VERIFICATION)

  emailVerified             Boolean     @default(false) @map("email_verified")
  phoneVerified             Boolean     @default(false) @map("phone_verified")

  passwordResetToken       String?     @map("password_reset_token")
  passwordResetExpires     DateTime?   @map("password_reset_expires")

  lastLoginAt     DateTime?   @map("last_login_at")

  // Relations
  providers       Provider[]
  doctorProfile   Doctor?
  searchLogs      SearchLog[]
  bookings        Booking[]
  reports         MedicalReport[] @relation("PatientReports")
  uploadedReports MedicalReport[] @relation("ReportUploader")

  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@index([email])
  @@index([phoneNumber])
  @@index([role])
  @@index([status])
  @@index([passwordResetToken])
  @@index([googleId])

  @@map("users")
}

// ─── Provider ───────────────────────────────────────────────

enum ProviderType {
  INDIVIDUAL_DOCTOR
  CLINIC
  HOSPITAL
  LAB
  BOTH
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ConsultationType {
  IN_PERSON
  ONLINE
  HOME_VISIT
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum DocumentType {
  DOCTOR_REGISTRATION
  QUALIFICATION_CERTIFICATE
  ID_PROOF
  FACILITY_REGISTRATION
  LICENSE
  ACCREDITATION
  OTHER
}

model Provider {
  id                      String              @id @default(uuid())
  name                    String
  slug                    String              @unique
  type                    ProviderType

  description             String?             @db.Text

  email                   String?
  phone                   String?
  website                 String?

  // Address
  address                 String?
  city                    String?
  state                   String?
  country                 String?             @default("India")
  pincode                 String?

  // Geolocation
  latitude                Float?
  longitude               Float?

  // Facility Details (CLINIC & HOSPITAL)
  establishedYear         Int?                @map("established_year")
  emergencyAvailable      Boolean             @default(false) @map("emergency_available")
  available24x7           Boolean             @default(false) @map("available_24x7")
  parkingAvailable        Boolean             @default(false) @map("parking_available")
  pharmacyAvailable       Boolean             @default(false) @map("pharmacy_available")
  wheelchairAccessible    Boolean             @default(false) @map("wheelchair_accessible")

  // Ratings & metrics
  rating                  Float?              @default(0)
  totalRatings            Int                 @default(0) @map("total_ratings")

  // Operating details
  openingHours            Json?               @map("opening_hours")
  homeCollectionAvailable Boolean             @default(false) @map("home_collection_available")

  // Images
  profileImage            String?             @map("profile_image")
  coverImage              String?             @map("cover_image")
  coverImages             Json            @default("[]") @map("cover_images")

  // Status flags
  isVerified              Boolean             @default(false) @map("is_verified")
  verificationStatus      VerificationStatus  @default(PENDING) @map("verification_status")
  isActive                Boolean             @default(true) @map("is_active")
  isFeatured              Boolean             @default(false) @map("is_featured")

  // Ownership
  ownerId                 String?             @map("owner_id")
  owner                   User?               @relation(fields: [ownerId], references: [id])

  // Relations
  doctors                 Doctor[]
  documents               VerificationDocument[]
  providerTests           ProviderTest[]
  bookings                Booking[]
  reports                 MedicalReport[]

  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")

  @@index([type])
  @@index([city])
  @@index([state])
  @@index([pincode])
  @@index([isVerified])
  @@index([verificationStatus])
  @@index([isActive])
  @@index([isFeatured])
  @@index([rating])
  @@index([ownerId])
  @@index([latitude, longitude])

  @@map("providers")
}

model Specialization {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  icon        String?
  description String?
  isActive    Boolean  @default(true) @map("is_active")

  doctors     Doctor[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("specializations")
}

model Doctor {
  id                        String              @id @default(uuid())
  userId                    String?             @unique @map("user_id")
  user                      User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  fullName                  String              @map("full_name")
  profileImage              String?             @map("profile_image")

  specializationId          String              @map("specialization_id")
  specialization            Specialization      @relation(fields: [specializationId], references: [id])

  qualification             String
  experienceYears           Int                 @default(0) @map("experience_years")
  medicalRegistrationNumber String              @unique @map("medical_registration_number")
  gender                    Gender
  languages                 Json            @default("[]")
  about                     String?             @db.Text

  consultationFee           Float               @default(0) @map("consultation_fee")
  onlineConsultationFee     Float?              @map("online_consultation_fee")
  inPersonConsultationFee   Float?              @map("in_person_consultation_fee")
  homeVisitFee              Float?              @map("home_visit_fee")
  consultationTypes         Json              @default("[\"IN_PERSON\"]") @map("consultation_types")

  providerId                String              @map("provider_id")
  provider                  Provider            @relation(fields: [providerId], references: [id], onDelete: Cascade)

  isActive                  Boolean             @default(true) @map("is_active")
  verificationStatus        VerificationStatus  @default(PENDING) @map("verification_status")

  // Ratings & metrics
  rating                    Float?              @default(0)
  totalRatings              Int                 @default(0) @map("total_ratings")
  profileViews              Int                 @default(0) @map("profile_views")

  availabilities            DoctorAvailability[]
  documents                 VerificationDocument[]
  conditions                DoctorCondition[]
  bookings                  Booking[]
  reports                   MedicalReport[]

  createdAt                 DateTime            @default(now()) @map("created_at")
  updatedAt                 DateTime            @updatedAt @map("updated_at")

  @@index([providerId])
  @@index([specializationId])
  @@index([isActive])
  @@index([verificationStatus])
  @@index([medicalRegistrationNumber])
  @@index([rating])
  @@map("doctors")
}

model DoctorAvailability {
  id           String    @id @default(uuid())
  doctorId     String    @map("doctor_id")
  doctor       Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  dayOfWeek    DayOfWeek @map("day_of_week")
  startTime    String    @map("start_time")
  endTime      String    @map("end_time")
  slotDuration Int       @default(30) @map("slot_duration")
  breakStart   String?   @map("break_start")
  breakEnd     String?   @map("break_end")
  isActive     Boolean   @default(true) @map("is_active")

  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([doctorId])
  @@index([dayOfWeek])
  @@map("doctor_availabilities")
}

model VerificationDocument {
  id                 String             @id @default(uuid())

  providerId         String?            @map("provider_id")
  provider           Provider?          @relation(fields: [providerId], references: [id], onDelete: Cascade)

  doctorId           String?            @map("doctor_id")
  doctor             Doctor?            @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  documentType       DocumentType       @map("document_type")
  documentUrl        String             @map("document_url")
  notes              String?
  uploadedAt         DateTime           @default(now()) @map("uploaded_at")
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")

  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  @@index([providerId])
  @@index([doctorId])
  @@map("verification_documents")
}

// ─── Conditions / Lifestyle Conditions ────────────────────────

model Condition {
  id          String            @id @default(uuid())
  name        String            @unique
  slug        String            @unique
  icon        String?
  description String?           @db.Text
  isActive    Boolean           @default(true) @map("is_active")
  profileViews Int              @default(0) @map("profile_views")

  // Relations
  doctors     DoctorCondition[]
  tests       TestCondition[]

  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("conditions")
}

model DoctorCondition {
  doctorId    String    @map("doctor_id")
  doctor      Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  conditionId String    @map("condition_id")
  condition   Condition @relation(fields: [conditionId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now()) @map("created_at")

  @@id([doctorId, conditionId])
  @@index([doctorId])
  @@index([conditionId])
  @@map("doctor_conditions")
}

// ─── Tests & Lab Tests ────────────────────────────────────────

model Test {
  id               String          @id @default(uuid())
  name             String
  slug             String          @unique
  code             String?         @unique
  description      String?         @db.Text
  shortDescription String?         @map("short_description")
  preparation      String?         @db.Text
  sampleType       String?         @map("sample_type")
  tat              String?
  price            Float?          @default(0)
  discountPrice    Float?          @map("discount_price")
  isActive         Boolean         @default(true) @map("is_active")
  isFeatured       Boolean         @default(false) @map("is_featured")
  profileViews     Int             @default(0) @map("profile_views")

  // Relations
  conditions       TestCondition[]
  providerTests    ProviderTest[]
  bookings         Booking[]
  reports          MedicalReport[]

  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([isFeatured])
  @@map("tests")
}

model TestCondition {
  testId      String    @map("test_id")
  test        Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  conditionId String    @map("condition_id")
  condition   Condition @relation(fields: [conditionId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now()) @map("created_at")

  @@id([testId, conditionId])
  @@index([testId])
  @@index([conditionId])
  @@map("test_conditions")
}

model ProviderTest {
  id                      String   @id @default(uuid())
  providerId              String   @map("provider_id")
  provider                Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  testId                  String   @map("test_id")
  test                    Test     @relation(fields: [testId], references: [id], onDelete: Cascade)

  price                   Float
  discountPrice           Float?   @map("discount_price")
  homeCollectionAvailable Boolean  @default(true) @map("home_collection_available")
  labVisitAvailable       Boolean  @default(true) @map("lab_visit_available")
  turnaroundTime          String?  @map("turnaround_time")
  isActive                Boolean  @default(true) @map("is_active")

  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@unique([providerId, testId])
  @@index([providerId])
  @@index([testId])
  @@index([price])
  @@index([isActive])
  @@map("provider_tests")
}

// ─── Analytics / Tracking ────────────────────────────────────────

model SearchLog {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  searchQuery String   @map("search_query")
  category    String
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([category])
  @@index([createdAt])
  @@map("search_logs")
}

// ─── Bookings ──────────────────────────────────────────────────

enum BookingMode {
  ONLINE
  OFFLINE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Booking {
  id               String        @id @default(uuid())
  bookingReference String        @unique @map("booking_reference")

  userId           String?       @map("user_id")
  user             User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  doctorId         String?       @map("doctor_id")
  doctor           Doctor?       @relation(fields: [doctorId], references: [id], onDelete: SetNull)

  providerId       String?       @map("provider_id")
  provider         Provider?     @relation(fields: [providerId], references: [id], onDelete: SetNull)

  testId           String?       @map("test_id")
  test             Test?         @relation(fields: [testId], references: [id], onDelete: SetNull)

  // Booking Specifications
  price            Float         @default(0)
  date             DateTime      @map("date")
  slotTime         String        @map("slot_time")
  mode             BookingMode   @default(ONLINE)

  // Patient Details
  patientName      String        @map("patient_name")
  age              Int           @map("age")
  gender           Gender        @map("gender")
  phone            String        @map("phone")
  reason           String?       @db.Text @map("reason")

  // Status & Metadata
  status            BookingStatus @default(PENDING)
  paymentStatus     PaymentStatus @default(PENDING) @map("payment_status")
  notes             String?       @db.Text

  // Razorpay Payment Details
  razorpayOrderId   String?       @map("razorpay_order_id")
  razorpayPaymentId String?       @map("razorpay_payment_id")
  razorpaySignature String?       @map("razorpay_signature")

  reports           MedicalReport[]

  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@index([userId])
  @@index([doctorId])
  @@index([providerId])
  @@index([testId])
  @@index([date])
  @@index([status])
  @@index([paymentStatus])
  @@index([bookingReference])
  @@index([razorpayOrderId])
  @@map("bookings")
}

// ─── Medical Reports ──────────────────────────────────────────

enum ReportType {
  LAB_REPORT
  PRESCRIPTION
  RADIOLOGY_SCAN
  DISCHARGE_SUMMARY
  OTHER
}

model MedicalReport {
  id              String         @id @default(uuid())
  reportNumber    String         @unique @map("report_number")
  title           String
  reportType      ReportType     @default(LAB_REPORT) @map("report_type")
  description     String?        @db.Text

  // Cloudflare R2 File Details
  fileUrl         String         @map("file_url")
  fileKey         String         @map("file_key")
  fileName        String         @map("file_name")
  fileSize        Int?           @map("file_size")
  mimeType        String?        @map("mime_type")

  reportDate      DateTime       @default(now()) @map("report_date")

  // Patient Info
  userId          String?        @map("user_id")
  user            User?          @relation("PatientReports", fields: [userId], references: [id], onDelete: SetNull)
  patientName     String         @map("patient_name")
  patientPhone    String         @map("patient_phone")
  patientAge      Int?           @map("patient_age")
  patientGender   Gender?        @map("patient_gender")

  // Originating Entity (Multi-Tenant Scoping)
  providerId      String?        @map("provider_id")
  provider        Provider?      @relation(fields: [providerId], references: [id], onDelete: SetNull)

  doctorId        String?        @map("doctor_id")
  doctor          Doctor?        @relation(fields: [doctorId], references: [id], onDelete: SetNull)

  testId          String?        @map("test_id")
  test            Test?          @relation(fields: [testId], references: [id], onDelete: SetNull)

  bookingId       String?        @map("booking_id")
  booking         Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  // Upload Audit
  uploadedById    String         @map("uploaded_by_id")
  uploadedBy      User           @relation("ReportUploader", fields: [uploadedById], references: [id])

  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@index([userId])
  @@index([patientPhone])
  @@index([providerId])
  @@index([doctorId])
  @@index([bookingId])
  @@index([testId])
  @@index([reportDate])
  @@index([reportType])
  @@map("medical_reports")
}
