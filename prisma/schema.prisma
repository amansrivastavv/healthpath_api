generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "mysql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  LAB_OWNER
  LAB_STAFF
  TECHNICIAN
  PATIENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

model User {
  id              String      @id @default(uuid())
  fullName        String      @map("full_name")
  email           String      @unique
  password        String

  phoneNumber     String?     @unique @map("phone_number")
  countryCode     String?     @map("country_code")

  profileImage    String?     @map("profile_image")

  role            UserRole    @default(PATIENT)
  status          UserStatus  @default(PENDING_VERIFICATION)

  emailVerified             Boolean     @default(false) @map("email_verified")
  phoneVerified             Boolean     @default(false) @map("phone_verified")

  passwordResetToken       String?     @map("password_reset_token")
  passwordResetExpires     DateTime?   @map("password_reset_expires")

  lastLoginAt     DateTime?   @map("last_login_at")

  // Relations
  providers       Provider[]

  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@index([email])
  @@index([phoneNumber])
  @@index([role])
  @@index([status])
  @@index([passwordResetToken])

  @@map("users")
}

// ─── Provider ───────────────────────────────────────────────

enum ProviderType {
  INDIVIDUAL_DOCTOR
  CLINIC
  HOSPITAL
  LAB
  BOTH
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ConsultationType {
  IN_PERSON
  ONLINE
  HOME_VISIT
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum DocumentType {
  DOCTOR_REGISTRATION
  QUALIFICATION_CERTIFICATE
  ID_PROOF
  FACILITY_REGISTRATION
  LICENSE
  ACCREDITATION
  OTHER
}

model Provider {
  id                      String              @id @default(uuid())
  name                    String
  slug                    String              @unique
  type                    ProviderType

  description             String?             @db.Text

  email                   String?
  phone                   String?
  website                 String?

  // Address
  address                 String?
  city                    String?
  state                   String?
  country                 String?             @default("India")
  pincode                 String?

  // Geolocation
  latitude                Float?
  longitude               Float?

  // Facility Details (CLINIC & HOSPITAL)
  establishedYear         Int?                @map("established_year")
  emergencyAvailable      Boolean             @default(false) @map("emergency_available")
  available24x7           Boolean             @default(false) @map("available_24x7")
  parkingAvailable        Boolean             @default(false) @map("parking_available")
  pharmacyAvailable       Boolean             @default(false) @map("pharmacy_available")
  wheelchairAccessible    Boolean             @default(false) @map("wheelchair_accessible")

  // Ratings & metrics
  rating                  Float?              @default(0)
  totalRatings            Int                 @default(0) @map("total_ratings")

  // Operating details
  openingHours            Json?               @map("opening_hours")
  homeCollectionAvailable Boolean             @default(false) @map("home_collection_available")

  // Images
  profileImage            String?             @map("profile_image")
  coverImage              String?             @map("cover_image")
  coverImages             Json            @default("[]") @map("cover_images")

  // Status flags
  isVerified              Boolean             @default(false) @map("is_verified")
  verificationStatus      VerificationStatus  @default(PENDING) @map("verification_status")
  isActive                Boolean             @default(true) @map("is_active")
  isFeatured              Boolean             @default(false) @map("is_featured")

  // Ownership
  ownerId                 String?             @map("owner_id")
  owner                   User?               @relation(fields: [ownerId], references: [id])

  // Relations
  doctors                 Doctor[]
  documents               VerificationDocument[]

  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")

  @@index([type])
  @@index([city])
  @@index([state])
  @@index([pincode])
  @@index([isVerified])
  @@index([verificationStatus])
  @@index([isActive])
  @@index([isFeatured])
  @@index([rating])
  @@index([ownerId])
  @@index([latitude, longitude])

  @@map("providers")
}

model Specialization {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  icon        String?
  description String?
  isActive    Boolean  @default(true) @map("is_active")

  doctors     Doctor[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("specializations")
}

model Doctor {
  id                        String              @id @default(uuid())
  fullName                  String              @map("full_name")
  profileImage              String?             @map("profile_image")

  specializationId          String              @map("specialization_id")
  specialization            Specialization      @relation(fields: [specializationId], references: [id])

  qualification             String
  experienceYears           Int                 @default(0) @map("experience_years")
  medicalRegistrationNumber String              @unique @map("medical_registration_number")
  gender                    Gender
  languages                 Json            @default("[]")
  about                     String?             @db.Text

  consultationFee           Float               @default(0) @map("consultation_fee")
  onlineConsultationFee     Float?              @map("online_consultation_fee")
  inPersonConsultationFee   Float?              @map("in_person_consultation_fee")
  homeVisitFee              Float?              @map("home_visit_fee")
  consultationTypes         Json              @default("[\"IN_PERSON\"]") @map("consultation_types")

  providerId                String              @map("provider_id")
  provider                  Provider            @relation(fields: [providerId], references: [id], onDelete: Cascade)

  isActive                  Boolean             @default(true) @map("is_active")
  verificationStatus        VerificationStatus  @default(PENDING) @map("verification_status")

  availabilities            DoctorAvailability[]
  documents                 VerificationDocument[]

  createdAt                 DateTime            @default(now()) @map("created_at")
  updatedAt                 DateTime            @updatedAt @map("updated_at")

  @@index([providerId])
  @@index([specializationId])
  @@index([isActive])
  @@index([verificationStatus])
  @@index([medicalRegistrationNumber])
  @@map("doctors")
}

model DoctorAvailability {
  id           String    @id @default(uuid())
  doctorId     String    @map("doctor_id")
  doctor       Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  dayOfWeek    DayOfWeek @map("day_of_week")
  startTime    String    @map("start_time")
  endTime      String    @map("end_time")
  slotDuration Int       @default(30) @map("slot_duration")
  breakStart   String?   @map("break_start")
  breakEnd     String?   @map("break_end")
  isActive     Boolean   @default(true) @map("is_active")

  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([doctorId])
  @@index([dayOfWeek])
  @@map("doctor_availabilities")
}

model VerificationDocument {
  id                 String             @id @default(uuid())

  providerId         String?            @map("provider_id")
  provider           Provider?          @relation(fields: [providerId], references: [id], onDelete: Cascade)

  doctorId           String?            @map("doctor_id")
  doctor             Doctor?            @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  documentType       DocumentType       @map("document_type")
  documentUrl        String             @map("document_url")
  notes              String?
  uploadedAt         DateTime           @default(now()) @map("uploaded_at")
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")

  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  @@index([providerId])
  @@index([doctorId])
  @@map("verification_documents")
}